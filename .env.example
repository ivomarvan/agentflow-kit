# ─── Primary backend and model ─────────────────────────────────────────────
# Select the active LLM backend.
# Supported values: openai | anthropic | ollama | gemini | deepseek
LLM_BACKEND=ollama

# Model name for the selected backend.
# openai examples:    gpt-4o-mini  |  gpt-4o
# anthropic examples: claude-3-haiku-20240307  |  claude-3-5-sonnet-20241022
# ollama examples:    qwen2.5:7b-instruct  |  llama3.1:8b
# gemini examples:    models/gemini-1.5-flash  |  models/gemini-2.0-flash
# deepseek examples:  deepseek-chat  |  deepseek-coder
LLM_MODEL=qwen2.5:7b-instruct

# ─── API keys (only the key for your chosen backend is required) ────────────
# OpenAI
OPENAI_API_KEY=...

# Google (Gemini)
GOOGLE_API_KEY=...

# DeepSeek
DEEPSEEK_API_KEY=...

# Anthropic (Claude)
ANTHROPIC_API_KEY=...

# ─── Available models per backend (optional — used by the GUI settings panel) ─
# Comma-separated list of model names shown in the GUI model selector.
# Leave as "..." to let the framework auto-discover (Ollama) or use defaults.

# Ollama — models returned by `ollama list`
OLLAMA_MODELS=...

# OpenAI
OPENAI_MODELS=...

# Gemini
GEMINI_MODELS=...

# DeepSeek
DEEPSEEK_MODELS=...

# Anthropic
ANTHROPIC_MODELS=...
